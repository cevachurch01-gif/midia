rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.email == 'geovanner13@gmail.com');
      allow update: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == 'geovanner13@gmail.com');
      allow delete: if isAuthenticated() && request.auth.token.email == 'geovanner13@gmail.com';
    }

    // Cultos, escalas, trocas, tarefas, comunicados
    match /{collectionName}/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
